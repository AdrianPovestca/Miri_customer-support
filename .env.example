# --- Knowledge base / retrieval ---
KNOWLEDGE_BASE_DIR=../knowledge_base
TOP_K_RESULTS=3
SCORE_THRESHOLD=0.05

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# --- LLM / OpenAI (Phase 2: LLM Integration) ---
# Leave OPENAI_API_KEY empty to keep using the Phase 1 template-based responses.
OPENAI_API_KEY=sk-cheia-ta-reala-aici
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=400

# Set to "false" to force template-only responses even if a key is present
USE_AI_GENERATION=true
